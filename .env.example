# Copy to `.env` and fill in locally. Never commit `.env`.
#
# Hugging Face (optional): used by `huggingface-cli login` / transformers downloads.
# HF_TOKEN=

# Weights & Biases (optional): only if you enable wandb logging.
# WANDB_API_KEY=

# Other providers — add only what you use:
# OPENAI_API_KEY=
