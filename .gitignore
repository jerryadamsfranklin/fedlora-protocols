# -----------------------------------------------------------------------------
# Secrets, credentials, and local environment (never commit these)
# -----------------------------------------------------------------------------
.env
.env.*
.envrc
.python-env
*.secret
secrets/
credentials/
*credentials*.json
service-account*.json
*.pem
id_rsa
id_rsa.pub
*.p12
.netrc
netrc

# Optional local overrides that may contain tokens or paths
config/local_config.yaml
config/*local*.yaml
*.override.yaml

# Hugging Face / ML tooling (if stored inside the repo tree)
.huggingface/

# -----------------------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Logs / experiment artifacts
wandb/
*.log
logs/

# Local caches
.cache/

# Experiment results: track summaries (JSON/CSV) for reproducibility.
# Ignore heavy artifacts if you ever write checkpoints under results/.
results/**/*.pt
results/**/*.pth
results/**/*.bin
results/**/*.safetensors
results/**/checkpoint*/

# Local exports: handoffs, Stage 0 summaries, Claude bundles (do not commit)
exports/**
!exports/.gitkeep
**/*handoff*.txt
**/*handoff*.md

# TMLR Path B implementation guide (optional local copy in docs/; do not track)
docs/TMLR_PATH_B_IMPLEMENTATION_GUIDE.md

# Figures: keep generated plots (usually small); ignore huge raw exports if needed
figures/**/*.tif
figures/**/*.psd
